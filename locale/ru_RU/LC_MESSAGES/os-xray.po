msgstr "Подписок пока нет. Существующие серверы остаются ручными."

msgid "Add subscription"
msgstr "Добавить подписку"

msgid "New servers are disabled. Select the servers you need in Endpoints, then click Apply. Disabled servers stay disabled after updates."
msgstr "Новые серверы выключены. Выберите нужные во вкладке Endpoints и нажмите Применить. Выключенные серверы останутся выключенными после обновлений."

msgid "HTTPS subscription URL"
msgstr "HTTPS-адрес подписки"

msgid "Update subscription"
msgstr "Обновить подписку"

msgid "Subscription not found"
msgstr "Подписка не найдена"

msgid "Saved. Use Update subscription to fetch servers."
msgstr "Сохранено. Нажмите Обновить подписку для загрузки серверов."

msgid "Updating subscription..."
msgstr "Обновление подписки..."

msgid "Delete this subscription and its endpoints?"
msgstr "Удалить подписку и её серверы?"

msgid "Saved. Click Apply to activate."
msgstr "Сохранено. Нажмите Применить для активации."

msgid "Removed"
msgstr "Удалён"

msgid "Missing from subscription"
msgstr "Отсутствует в подписке"

msgid "Disabled"
