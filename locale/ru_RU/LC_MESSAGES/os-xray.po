msgstr ""
"Правило сохранено. Проверьте его порядок и примените изменения в правилах"
" firewall."


msgid "Status"
msgstr "Статус"

msgid "Not tested"
msgstr "Не проверен"

msgid "Status unavailable"
msgstr "Статус недоступен"

