msgstr "Не удалось удалить серверы"

msgid "Save failed"
msgstr "Не удалось сохранить"

msgid "Request failed"
msgstr "Не удалось выполнить запрос"

msgid "Could not load endpoints"
msgstr "Не удалось загрузить серверы"

