msgstr "Максимальный размер файла — 1 МиБ"

msgid "Enter a server link or select a subscription file"
msgstr "Введите ссылку или выберите файл подписки"

msgid "Removed. Click Apply to activate."
msgstr "Удалено. Нажмите «Применить» для активации."

msgid "Firewall rule"
msgstr "Правило"

msgid "Create an IPv4 LAN rule for XRAY_HOSTS via gateway"
msgstr "Создать IPv4-правило LAN для XRAY_HOSTS через шлюз"

msgid "Rule saved. Check its order and apply it in Firewall Rules."
msgstr ""
"Правило сохранено. Проверьте его порядок и примените изменения в правилах"
" firewall."


msgid "Status"
msgstr "Статус"

msgid "Not tested"
msgstr "Не проверен"

msgid "Status unavailable"
msgstr "Статус недоступен"

msgid "Xray is stopped"
msgstr "Xray выключен"

msgid "Healthy"
msgstr "Работает"

msgid "Failed"
msgstr "Не работает"

msgid "Interface enabled and configured:"
msgstr "Интерфейс включён и настроен:"

msgid "Tunnel gateway address:"
msgstr "Адрес шлюза туннеля:"

msgid "Custom domains and subdomains"
msgstr "Свои домены и поддомены"

msgid "Custom exact hostnames"
msgstr "Свои точные имена хостов"

msgid "Automatically update community lists"
msgstr "Автоматически обновлять community-списки"

msgid "Download geosite and geoip daily at 04:23 firewall time and apply the selected categories and custom domains."
msgstr "Ежедневно в 04:23 по времени межсетевого экрана загружать geosite и geoip и применять выбранные категории и свои домены."

msgid "One domain per line, for example example.com. Includes all subdomains. Matching DNS answers are added to XRAY_HOSTS."
msgstr "По одному домену на строку, например example.com. Включает все поддомены. Адреса из ответов DNS добавляются в XRAY_HOSTS."

msgid "One exact hostname per line, for example api.example.com. Subdomains are not included."
msgstr "По одному точному имени на строку, например api.example.com. Поддомены не включаются."

msgid "Site routing test"
msgstr "Проверка маршрутизации сайта"

msgid "Domain or website URL"
msgstr "Домен или URL сайта"

msgid "Tests applied lists through local Unbound and checks XRAY_HOSTS. Does not test client firewall rules or proxy connectivity."
msgstr "Проверяет применённые списки через локальный Unbound и наличие адресов в XRAY_HOSTS. Не проверяет правила firewall клиентов и соединение через прокси."

msgid "Domain matches applied lists"
msgstr "Домен совпадает с применёнными списками"

msgid "Domain does not match applied lists"
msgstr "Домен не совпадает с применёнными списками"

msgid "In alias"
msgstr "В алиасе"

msgid "Not in alias"
msgstr "Нет в алиасе"

msgid "Match"
msgstr "Совпадение"

msgid "No A or AAAA addresses returned"
msgstr "Ответ не содержит адресов A или AAAA"

msgid "Subscriptions"
msgstr "Подписки"

msgid "Subscription"
msgstr "Подписка"

msgid "Automatic updates"
msgstr "Автоматическое обновление"

msgid "Interval (minutes)"
msgstr "Интервал (минуты)"

msgid "Servers"
msgstr "Серверы"

msgid "Last successful update"
msgstr "Последнее успешное обновление"

msgid "Last error"
msgstr "Последняя ошибка"

